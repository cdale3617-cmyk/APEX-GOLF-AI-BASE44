{
  "name": "CourseInfo",
  "type": "object",
  "properties": {
    "course_key": {
      "type": "string",
      "description": "Stable id of the course this card belongs to"
    },
    "name": {
      "type": "string",
      "description": "Course name, for readability in the dashboard"
    },
    "tee_name": {
      "type": "string",
      "description": "Which tee set the hole yardages were read from"
    },
    "holes": {
      "type": "array",
      "description": "Card par and yardage for each hole",
      "items": {
        "type": "object"
      }
    },
    "fetched_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "course_key"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}