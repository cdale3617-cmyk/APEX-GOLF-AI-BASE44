{
  "name": "CourseMap",
  "type": "object",
  "properties": {
    "course_key": {
      "type": "string",
      "description": "Stable id of the course this map belongs to"
    },
    "name": {
      "type": "string",
      "description": "Course name, for readability in the dashboard"
    },
    "hole_count": {
      "type": "number",
      "description": "How many holes were mapped when this was cached"
    },
    "elements": {
      "type": "array",
      "description": "Raw OpenStreetMap hole, green and tee geometry",
      "items": {
        "type": "object"
      }
    },
    "fetched_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "course_key"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}